    "preview": "vite preview",
    "simcheck": "tsx scripts/simcheck.ts",
    "ailab": "tsx scripts/ai-lab.ts",
    "ailab2": "tsx scripts/ai-lab2.ts",
    "ailab3": "tsx scripts/ai-lab3.ts",
    "ailab4": "tsx scripts/ai-lab4.ts",
    "ops": "tsx scripts/ops-check.ts",
    "rest": "tsx scripts/rest-check.ts",
    "overlap": "tsx scripts/overlap.ts",
    "promise": "tsx scripts/promise-check.ts",
    "journeys": "tsx scripts/journey-check.ts",
    "agentcheck": "tsx scripts/agent-check.ts",
    "agenteval": "tsx scripts/agent-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "lucide-react": "^1.51.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
